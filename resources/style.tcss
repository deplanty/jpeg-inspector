$tab-width: 20;

/* Browser */

.browser {
    height: auto;
}

.browser {
    margin-left: 1;
    margin-right: 1;
}

/* Notebook */

Notebook {
    height: 1fr;
    min-height: 0;
}

Tree {
    width: auto;
    min-width: $tab-width;
}


Tree:blur > .tree--cursor, Tree:focus > .tree--cursor {
    background: $primary;
    text-style: bold;
}
