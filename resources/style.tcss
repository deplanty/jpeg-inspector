$tab-width: 12;

Horizontal.browser {
    height: auto;
    align: left middle;
}

Horizontal.browser > Label {
    height: 100%;
    content-align-vertical: middle;
    margin-left: 1;
}

VerticalScroll.notebook-tab {
    width: auto;
    min-width: $tab-width;
}

Button.notebook-tab {
    min-width: $tab-width;
    background: initial;
}

Button.notebook-tab.selected {
    background: $primary;
}

Notebook {
    height: 1fr;
    min-height: 0;
}
