$tab-width: 12;

/* Browser */

.browser {
    height: auto;
}

.browser {
    margin-left: 1;
    margin-right: 1;
}

/* Notebook */

Notebook {
    height: 1fr;
    min-height: 0;
}

VerticalScroll.notebook-tab {
    width: auto;
    min-width: $tab-width;
}

Button.notebook-tab {
    min-width: $tab-width;
    background: initial;
}

Button.notebook-tab.selected {
    background: $primary;
}
